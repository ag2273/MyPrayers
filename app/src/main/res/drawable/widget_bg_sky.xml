<?xml version="1.0" encoding="utf-8"?>
<!-- Widget surface in the "A Day That Breathes" colours (1.4): the light sky, warm at the top. The root sets its opacity from Settings -> Widgets (#32). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#FFFBF1E2"
        android:centerColor="#FFF2F6F4"
        android:endColor="#FFDDEEEA"
        android:type="linear" />
    <corners android:radius="@dimen/widget_radius" />
</shape>
