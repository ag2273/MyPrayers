<?xml version="1.0" encoding="utf-8"?>
<!-- Week Prayer Log dot: its time arrived and it is not marked (hollow). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
    <!-- A transparent fill, never none: with no fill, a tinted shape fills its inside with the tint colour. -->
    <solid android:color="@android:color/transparent" />
    <size android:width="14dp" android:height="14dp" />
    <stroke android:width="1.5dp" android:color="@android:color/white" />
</shape>
