    <!-- Fix alerts (#29). -->
    <string name="fix_alerts">Fix alerts</string>
    <string name="fix_alerts_summary">If alerts come late or not at all</string>
    <string name="fix_alerts_tip">Your phone may delay Adhan Alerts to save battery. A few steps stop that.</string>
    <string name="fix_alerts_intro">Battery saving on %1$s phones can delay or stop Adhan Alerts. Change these settings yourself:</string>
    <string name="fix_open_app_settings">Open app settings</string>
    <string name="fix_open_battery_settings">Open battery optimisation settings</string>
    <string name="brand_samsung">Samsung</string>
    <string name="brand_xiaomi">Xiaomi, Redmi and POCO</string>
    <string name="brand_huawei">Huawei and Honor</string>
    <string name="brand_oppo">Oppo, Realme and OnePlus</string>
    <string name="brand_vivo">vivo</string>
    <string name="brand_other">some</string>
    <string name="fix_samsung_1">In app settings: Battery → Unrestricted.</string>
    <string name="fix_samsung_2">In Settings → Battery and device care → Battery → Background usage limits: remove Mawaqeet from Sleeping and Deep sleeping apps.</string>
    <string name="fix_samsung_3">Add Mawaqeet to Never sleeping apps.</string>
    <string name="fix_xiaomi_1">In app settings: turn on Autostart.</string>
    <string name="fix_xiaomi_2">In app settings: Battery saver → No restrictions.</string>
    <string name="fix_xiaomi_3">In recent apps, long-press Mawaqeet and lock it.</string>
    <string name="fix_huawei_1">In Settings → Battery → App launch: set Mawaqeet to Manage manually and turn on all three options.</string>
    <string name="fix_huawei_2">In app settings: Battery → allow background activity.</string>
    <string name="fix_oppo_1">In app settings: Battery usage → allow background activity.</string>
    <string name="fix_oppo_2">In app settings: turn on Auto launch.</string>
    <string name="fix_oppo_3">In battery optimisation settings: set Mawaqeet to Don\'t optimise.</string>
    <string name="fix_vivo_1">In Settings → Battery → Background power consumption: allow Mawaqeet.</string>
    <string name="fix_vivo_2">In app settings: turn on Autostart.</string>
    <string name="fix_general_1">In app settings: Battery → Unrestricted or Not optimised.</string>
    <string name="fix_general_2">In battery optimisation settings: set Mawaqeet to Don\'t optimise.</string>
