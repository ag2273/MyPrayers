<?xml version="1.0" encoding="utf-8"?>
<!-- A Clock Widget's big thin clock, ticked by the launcher in the phone's 12/24-hour setting. Size, colour and formats are set in code (ClockFace in BigClockWidget.kt). -->
<TextClock xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clock"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fontFamily="sans-serif-light"
    android:format12Hour="h:mm"
    android:format24Hour="HH:mm"
    android:includeFontPadding="false"
    android:maxLines="1"
    android:textSize="44sp" />
