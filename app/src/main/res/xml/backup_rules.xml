<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 8-11 backup rules (#25), the same choice as data_extraction_rules.xml: an <include> with
  requireFlags="deviceToDeviceTransfer" is copied only in a direct transfer to a new phone, never to the cloud.
  Once any <include> is listed only included files are backed up, so the rest of the app's files are listed too.
  prayer_log.db holds the Prayer Log and the Adhkar Record (#74).
  The Backup File (#98) the user exports by hand from Settings → Backup is not covered by these rules: it is saved
  only where they choose with the system file picker.
-->
<full-backup-content>
    <include domain="database" path="prayer_log.db" requireFlags="deviceToDeviceTransfer" />
    <include domain="database" path="prayer_log.db-shm" requireFlags="deviceToDeviceTransfer" />
    <include domain="database" path="prayer_log.db-wal" requireFlags="deviceToDeviceTransfer" />
    <include domain="file" path="datastore/settings.preferences_pb" requireFlags="deviceToDeviceTransfer" />
    <!-- AppCompat's copy of the per-app language on Android 8-12. -->
    <include domain="file" path="androidx.appcompat.app.AppCompatDelegate.application_locales_record_file" />
    <include domain="sharedpref" path="." />
</full-backup-content>
