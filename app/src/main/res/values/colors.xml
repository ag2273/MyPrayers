<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Brand palette, light. Keep in sync with ui/theme/Color.kt. -->
    <color name="window_background">#F2F6F4</color>
    <!-- Widgets (default look; #32 adds appearance settings). DayMist, Ink, Ink 72%, NightTeal. -->
    <color name="widget_background">#F2F6F4</color>
    <color name="widget_text">#142421</color>
    <color name="widget_text_muted">#525F5C</color>
    <color name="widget_accent">#1F6F66</color>
    <color name="widget_on_accent">#FFFFFF</color>
    <color name="widget_accent_soft">#D6E8E4</color>
    <color name="widget_dot_upcoming">#2E525F5C</color>
    <!-- #32: text over a 60%+ transparent background: light, with a soft shadow, on any wallpaper (both themes). -->
    <color name="widget_over_text">#F4F7F5</color>
    <color name="widget_over_muted">#DFE8E3</color>
    <color name="widget_over_accent">#9FE3D5</color>
    <color name="widget_over_on_accent">#0B1F19</color>
    <color name="widget_over_accent_soft">#38FFFFFF</color>
    <color name="widget_over_faint">#50FFFFFF</color>
    <color name="widget_text_shadow">#A6000000</color>
    <!-- #32: wallpaper colours. Android 12+ overrides these with the system palette (values-v31); below, the app's. -->
    <color name="widget_dyn_background">@color/widget_background</color>
    <color name="widget_dyn_text">@color/widget_text</color>
    <color name="widget_dyn_muted">@color/widget_text_muted</color>
    <color name="widget_dyn_accent">@color/widget_accent</color>
    <color name="widget_dyn_on_accent">@color/widget_on_accent</color>
    <color name="widget_dyn_accent_soft">@color/widget_accent_soft</color>
    <color name="widget_dyn_over_accent">@color/widget_over_accent</color>
</resources>
