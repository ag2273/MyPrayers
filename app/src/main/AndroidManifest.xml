<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Adhan Alerts (#18). SCHEDULE_EXACT_ALARM, never USE_EXACT_ALARM (Play policy: alarm/calendar apps only). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Adhan playback (#22): the player is a mediaPlayback foreground service; the app vibrates itself.
         The channel-sound fallback build (src/channelSoundFallback) removes the service and its permissions. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Automatic location (#24): approximate only, read only while the app is open. Never FINE or BACKGROUND. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:name=".MawaqeetApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mawaqeet">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The scheduler's own alarms. Direct-boot aware so alerts fire before the first unlock. -->
        <receiver
            android:name=".alerts.AlertReceiver"
            android:directBootAware="true"
            android:exported="false" />

        <!-- "Mark as prayed" on the Adhan Alert (#26). Not direct-boot aware: the Prayer Log needs an unlocked phone. -->
        <receiver
            android:name=".alerts.MarkPrayedReceiver"
            android:exported="false" />

        <!-- The adhan player (#22). Direct-boot aware like AlertReceiver, which starts it. -->
        <service
            android:name=".alerts.AdhanPlayerService"
            android:directBootAware="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- System events after which alarms must be rescheduled (all allowed as manifest receivers). -->
        <receiver
            android:name=".alerts.RescheduleReceiver"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Per-app language backport storage for API 26-32 (AppCompat). -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!-- Next Prayer widget (#27): one Glance widget, two picker entries (2×2 and compact 2×1). -->
        <receiver
            android:name=".widget.NextPrayerWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_next_prayer">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/next_prayer_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.NextPrayerCompactWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_next_prayer">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/next_prayer_compact_widget_info" />
        </receiver>
        <!-- Today's Prayer Times (4×2) and Date strip (4×1) widgets (#30). -->
        <receiver
            android:name=".widget.TodayTimesWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_today_times">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_times_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.DateStripWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_date_strip">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/date_strip_widget_info" />
        </receiver>
        <!-- Today with Prayer Log and Week Prayer Log widgets (#31), 4×3; display only. -->
        <receiver
            android:name=".widget.TodayLogWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_today_log">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_log_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.WeekLogWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_week_log">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/week_log_widget_info" />
        </receiver>
    </application>
</manifest>
